{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDT Handshake Report",
  "type": "object",
  "required": [
    "handshake_id",
    "agent",
    "timestamp",
    "summary"
  ],
  "properties": {
    "handshake_id": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "artifacts_added": {
      "type": "array"
    },
    "plan_next": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "asks_of_other": {
      "type": "array"
    }
  }
}